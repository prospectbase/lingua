{
  "name": "@prospectbase/lingua",
  "version": "1.8.0",
  "description": "Accurate language detection for Node.js and TypeScript, even on short text. Native bindings for lingua-rs: 75 languages, offline, no API key.",
  "keywords": [
    "language-detection",
    "language-detector",
    "detect-language",
    "language-identification",
    "language-recognition",
    "identify-language",
    "lingua",
    "nlp",
    "natural-language-processing",
    "text-classification",
    "i18n",
    "multilingual",
    "short-text",
    "ngram",
    "napi-rs",
    "native",
    "rust",
    "typescript"
  ],
  "homepage": "https://github.com/prospectbase/lingua#readme",
  "bugs": {
    "url": "https://github.com/prospectbase/lingua/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prospectbase/lingua.git"
  },
  "license": "Apache-2.0",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "lingua",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">= 20"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node --test __test__/*.test.mjs",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.9"
  }
}
